  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@opentui/react": "^0.5.1",
    "react": "^19.2.8"
  }
}
